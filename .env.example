DATABASE_PATH=./data/data.sqlite
DEVICE_TOKEN=change-device-token
SESSION_SECRET=change-secret-of-at-least-32-characters
LOG_LEVEL=info

# Public port, served by the dashboard.
PORT=3000
# API port. Loopback only; the dashboard forwards /api to it.
API_PORT=3001

# Public URL of the dashboard, no trailing slash. Required in production:
# without it the dashboard assumes http://localhost:PORT and rejects form POSTs.
ORIGIN=https://sc.example.com

# Addresses allowed to set X-Forwarded-*. Only the dashboard talks to the API,
# from the loopback, so one address is enough.
TRUST_PROXY=127.0.0.1

# API the dashboard forwards to. Defaults to API_PORT.
# API_BASE_URL=http://127.0.0.1:3001

# Protocol announced to the API on that hop. Defaults to https.
# API_FORWARDED_PROTO=https
