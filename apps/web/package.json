    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@types/node": "^22.10.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@sc/db": "workspace:*",
    "drizzle-orm": "^0.45.4"
