# Local development values. Not secrets.
DATABASE_PATH=./data/data.sqlite
DEVICE_TOKEN=dev
SESSION_SECRET=local-development-secret-at-least-32-chars-long

# The dashboard runs under `vite dev`, which listens on WEB_PORT (5173).
WEB_PORT=5173
# The API stays behind it, on the loopback.
API_PORT=3001
API_BASE_URL=http://127.0.0.1:3001
# No TLS in development, so the session cookie is not `Secure`.
API_FORWARDED_PROTO=http
